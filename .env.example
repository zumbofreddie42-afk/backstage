# Copia in .env.local e compila. Non mettere mai chiavi reali in git.

# Pubblicazione (lascia vuoto per l'anteprima)
SITE_MODE=
NEXT_PUBLIC_SITE_URL=

# Database e file (obbligatori su Vercel; senza, il sito usa la cartella locale .data)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Accesso al pannello /staff (solo Christina)
ADMIN_PASSWORD=
SESSION_SECRET=

# AI English Tutor (senza chiave resta dimostrativo)
ANTHROPIC_API_KEY=
TUTOR_MODEL=claude-opus-5-5
TUTOR_ACCESS=students

# Email (Resend) per avvisi e promemoria
RESEND_API_KEY=
EMAIL_FROM=
SCHOOL_NOTIFY_EMAIL=

# Promemoria automatici (Vercel Cron)
CRON_SECRET=
